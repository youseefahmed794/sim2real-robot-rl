<mujoco model="quadruped_12dof">
  <compiler angle="radian" coordinate="local" inertiafromgeom="false"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="Newton" cone="elliptic"/>

  <default>
    <joint limited="true" damping="0.5" armature="0.01"/>
    <geom condim="3" friction="0.8 0.05 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    <motor ctrlrange="-35.5 35.5" ctrllimited="true"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"/>
    <material name="grid_mat" texture="grid" texrepeat="1 1" reflectance="0.2"/>
    <material name="chassis" rgba="0.2 0.2 0.2 1.0"/>
    <material name="leg_cyan" rgba="0.0 0.7 0.9 1.0"/>
    <material name="foot_rubber" rgba="0.1 0.1 0.1 1.0"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid_mat"/>

    <body name="base_link" pos="0 0 0.35">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="6.0" diaginertia="0.035 0.085 0.105"/>
      <geom name="base_geom" type="box" size="0.19 0.10 0.055" material="chassis"/>

      <!-- ==================== FRONT LEFT (FL) ==================== -->
      <body name="FL_hip" pos="0.19 0.10 0">
        <inertial pos="0 0.04 0" mass="0.55" diaginertia="0.0004 0.0006 0.0005"/>
        <joint name="FL_hip_joint" type="hinge" axis="1 0 0" range="-0.80 0.80"/>
        <geom name="FL_hip_geom" type="capsule" fromto="0 0 0 0 0.08 0" size="0.035"/>

        <body name="FL_thigh" pos="0 0.08 0">
          <inertial pos="0 0.02 -0.10" mass="0.75" diaginertia="0.0035 0.0038 0.0008"/>
          <joint name="FL_thigh_joint" type="hinge" axis="0 1 0" range="-1.00 3.50"/>
          <geom name="FL_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.21" size="0.025" material="leg_cyan"/>

          <body name="FL_calf" pos="0 0 -0.21">
            <inertial pos="0 0 -0.10" mass="0.32" diaginertia="0.0018 0.0019 0.0002"/>
            <joint name="FL_calf_joint" type="hinge" axis="0 1 0" range="-2.70 -0.60"/>
            <geom name="FL_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.21" size="0.015"/>
            <geom name="FL_foot" type="sphere" pos="0 0 -0.21" size="0.022" material="foot_rubber"/>
          </body>
        </body>
      </body>

      <!-- ==================== FRONT RIGHT (FR) ==================== -->
      <body name="FR_hip" pos="0.19 -0.10 0">
        <inertial pos="0 -0.04 0" mass="0.55" diaginertia="0.0004 0.0006 0.0005"/>
        <joint name="FR_hip_joint" type="hinge" axis="1 0 0" range="-0.80 0.80"/>
        <geom name="FR_hip_geom" type="capsule" fromto="0 0 0 0 -0.08 0" size="0.035"/>

        <body name="FR_thigh" pos="0 -0.08 0">
          <inertial pos="0 -0.02 -0.10" mass="0.75" diaginertia="0.0035 0.0038 0.0008"/>
          <joint name="FR_thigh_joint" type="hinge" axis="0 1 0" range="-1.00 3.50"/>
          <geom name="FR_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.21" size="0.025" material="leg_cyan"/>

          <body name="FR_calf" pos="0 0 -0.21">
            <inertial pos="0 0 -0.10" mass="0.32" diaginertia="0.0018 0.0019 0.0002"/>
            <joint name="FR_calf_joint" type="hinge" axis="0 1 0" range="-2.70 -0.60"/>
            <geom name="FR_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.21" size="0.015"/>
            <geom name="FR_foot" type="sphere" pos="0 0 -0.21" size="0.022" material="foot_rubber"/>
          </body>
        </body>
      </body>

      <!-- ==================== REAR LEFT (RL) ==================== -->
      <body name="RL_hip" pos="-0.19 0.10 0">
        <inertial pos="0 0.04 0" mass="0.55" diaginertia="0.0004 0.0006 0.0005"/>
        <joint name="RL_hip_joint" type="hinge" axis="1 0 0" range="-0.80 0.80"/>
        <geom name="RL_hip_geom" type="capsule" fromto="0 0 0 0 0.08 0" size="0.035"/>

        <body name="RL_thigh" pos="0 0.08 0">
          <inertial pos="0 0.02 -0.10" mass="0.75" diaginertia="0.0035 0.0038 0.0008"/>
          <joint name="RL_thigh_joint" type="hinge" axis="0 1 0" range="-1.00 3.50"/>
          <geom name="RL_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.21" size="0.025" material="leg_cyan"/>

          <body name="RL_calf" pos="0 0 -0.21">
            <inertial pos="0 0 -0.10" mass="0.32" diaginertia="0.0018 0.0019 0.0002"/>
            <joint name="RL_calf_joint" type="hinge" axis="0 1 0" range="-2.70 -0.60"/>
            <geom name="RL_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.21" size="0.015"/>
            <geom name="RL_foot" type="sphere" pos="0 0 -0.21" size="0.022" material="foot_rubber"/>
          </body>
        </body>
      </body>

      <!-- ==================== REAR RIGHT (RR) ==================== -->
      <body name="RR_hip" pos="-0.19 -0.10 0">
        <inertial pos="0 -0.04 0" mass="0.55" diaginertia="0.0004 0.0006 0.0005"/>
        <joint name="RR_hip_joint" type="hinge" axis="1 0 0" range="-0.80 0.80"/>
        <geom name="RR_hip_geom" type="capsule" fromto="0 0 0 0 -0.08 0" size="0.035"/>

        <body name="RR_thigh" pos="0 -0.08 0">
          <inertial pos="0 -0.02 -0.10" mass="0.75" diaginertia="0.0035 0.0038 0.0008"/>
          <joint name="RR_thigh_joint" type="hinge" axis="0 1 0" range="-1.00 3.50"/>
          <geom name="RR_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.21" size="0.025" material="leg_cyan"/>

          <body name="RR_calf" pos="0 0 -0.21">
            <inertial pos="0 0 -0.10" mass="0.32" diaginertia="0.0018 0.0019 0.0002"/>
            <joint name="RR_calf_joint" type="hinge" axis="0 1 0" range="-2.70 -0.60"/>
            <geom name="RR_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.21" size="0.015"/>
            <geom name="RR_foot" type="sphere" pos="0 0 -0.21" size="0.022" material="foot_rubber"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <motor name="FL_hip_motor" joint="FL_hip_joint"/>
    <motor name="FL_thigh_motor" joint="FL_thigh_joint"/>
    <motor name="FL_calf_motor" joint="FL_calf_joint"/>

    <motor name="FR_hip_motor" joint="FR_hip_joint"/>
    <motor name="FR_thigh_motor" joint="FR_thigh_joint"/>
    <motor name="FR_calf_motor" joint="FR_calf_joint"/>

    <motor name="RL_hip_motor" joint="RL_hip_joint"/>
    <motor name="RL_thigh_motor" joint="RL_thigh_joint"/>
    <motor name="RL_calf_motor" joint="RL_calf_joint"/>

    <motor name="RR_hip_motor" joint="RR_hip_joint"/>
    <motor name="RR_thigh_motor" joint="RR_thigh_joint"/>
    <motor name="RR_calf_motor" joint="RR_calf_joint"/>
  </actuator>
</mujoco>
