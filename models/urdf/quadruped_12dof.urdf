<?xml version="1.0"?>
<robot name="quadruped_12dof">
  <!-- Base Link / Trunk -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.035" ixy="0.0" ixz="0.0" iyy="0.085" iyz="0.0" izz="0.105"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.20 0.11"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.20 0.11"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== FRONT LEFT (FL) LEG ==================== -->
  <link name="FL_hip">
    <inertial>
      <origin xyz="0 0.04 0" rpy="0 0 0"/>
      <mass value="0.55"/>
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.0006" iyz="0.0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0.04 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.08"/>
      </geometry>
      <material name="metallic">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.04 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_hip_joint" type="revolute">
    <origin xyz="0.19 0.10 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="FL_hip"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.80" upper="0.80" effort="35.5" velocity="21.0"/>
  </joint>

  <link name="FL_thigh">
    <inertial>
      <origin xyz="0 0.02 -0.10" rpy="0 0 0"/>
